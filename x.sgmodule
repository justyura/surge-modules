#!name=X 去广告、屏蔽中文和翻译
#!desc=Safari 里看 x.com 时，时间线、推文详情、搜索、趋势里的推广和中文推文直接从接口里删掉，留下的外文推文加上 DeepL 翻译
#!category=Enhancement
#!arguments=屏蔽中文:true,中文判定:normal,白名单:"不屏蔽的账号，多个用竖线分隔",DeepL密钥:"填你的DeepL密钥，多个用竖线分隔",目标语言:ZH-HANS,翻译:all,备用翻译:google,最长等待:4,调试日志:false
#!arguments-desc=屏蔽中文\ntrue：删掉中文推文；false：只去广告\n\n中文判定\n- normal：推文正文是中文才删（转推看被转的那条）\n- strict：另外，引用了中文推文、作者名字或简介里有汉字的推文也删，推荐关注里名字带汉字的账号也删。纯汉字的日文名字会误伤\n\n白名单\n这些账号的推文不删，填 @ 后面的用户名，多个用 | 分隔，不分大小写\n\nDeepL密钥\n一个或多个 DeepL API key，用 | 分隔，按顺序使用。可以和「YouTube 双语字幕」「Reddit 去广告和翻译」填一样的，key 暂停的状态几个模块共用\n\n目标语言\nZH-HANS 简体中文，ZH-HANT 繁体中文，也可以填 EN-US、JA、KO 等\n\n翻译\n- all：推文正文后面接上译文\n- off：不翻译，只去广告和屏蔽中文\n\n备用翻译\n- google：所有 DeepL key 都不能用时改用 Google 翻译\n- off：不兜底，显示原文\n\n最长等待\n最多等几秒翻译，到时间没翻完的显示原文。觉得刷新慢就调小\n\n调试日志\ntrue：在 Surge 日志里打印每个接口删了哪些条目、翻了几条

# 脚本：scripts/x.js（本仓库自己写的）
# Surge 一个响应只跑一个脚本，所以去广告、屏蔽中文和翻译放在同一个脚本里
# 只管网页版（Safari）。X App 里的推广帖目前没有能用的规则，见 README

[Rule]
# 不让 x.com 走 QUIC，保证请求能被 MITM
AND,((PROTOCOL,QUIC),(DOMAIN,x.com)),REJECT

[Script]
X = type=http-response,pattern=^https:\/\/(?:(?:x|twitter)\.com\/i\/api|api\.(?:x|twitter)\.com)\/graphql\/[\w-]+\/(?:\w*Timeline\w*|TweetDetail|ExplorePage|UserTweets\w*|UserMedia|UserHighlightsTweets|Likes|Bookmarks)(?:\?|$),requires-body=1,max-size=5242880,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/x.js,argument="chinese={{{屏蔽中文}}}&mode={{{中文判定}}}&allow={{{白名单}}}&keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate={{{翻译}}}&fallback={{{备用翻译}}}&budget={{{最长等待}}}&debug={{{调试日志}}}"

[MITM]
hostname = %APPEND% x.com, twitter.com
