#!name=YouTube去广告
#!desc=首页、搜索、播放页、Shorts 里的广告，片头和中途插播广告，适用于 YouTube 和 YouTube Music。还能隐藏 Shorts、小游戏，自动打开字幕
#!category=AdBlock
#!arguments=YouTube隐藏Shorts:true,YouTube隐藏游戏:true,YouTube隐藏竖屏直播:true,YouTube自动字幕:true
#!arguments-desc=YouTube 的几个开关，只能填 true（开）或 false（关）\n\nYouTube隐藏Shorts：底部的 Shorts 标签、首页和搜索里的 Shorts 栏\n\nYouTube隐藏游戏：首页里的 Playables 小游戏\n\nYouTube隐藏竖屏直播：推荐里的竖屏直播\n\nYouTube自动字幕：打开视频时自动开字幕，优先用视频原语言的字幕；配合「YouTube 双语字幕」模块就是自动双语

# 脚本来自 gholts/surge（在 Maasea/sgmodule 基础上改的，Apache-2.0），存了一份在本仓库 scripts/vendor/gholts-surge
# 它会处理加密的播放数据（Onesie / UMP）：本地识别出来就回空响应，让 App 退回能改的普通接口，再把广告删掉。
# 不会把请求转给任何第三方服务器。
# 隐藏 Shorts 栏和自动字幕是本仓库自己加的，改动在 scripts/vendor/gholts-surge/local.patch

[Rule]
# 不让 YouTube 走 QUIC（UDP），否则 Surge 解不了密，广告去不掉
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,googlevideo.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT

[URL Rewrite]
# 广告统计和广告页面
^https:\/\/www\.youtube\.com\/(?:pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject

[Script]
# 播放中途来要插播广告：回空
YouTube插播广告 = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/gholts-surge/request.js
# 首页、搜索、播放页等接口：删广告
YouTube = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,argument="{"blockUpload":false,"blockShorts":{{{YouTube隐藏Shorts}}},"blockGames":{{{YouTube隐藏游戏}}},"blockVerticalLive":{{{YouTube隐藏竖屏直播}}},"autoCaptions":{{{YouTube自动字幕}}},"jumpAhead":false,"autoHd":false}",script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/gholts-surge/response.js
# 播放数据（Onesie / UMP）
YouTube播放请求 = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/gholts-surge/request.js
YouTube播放数据 = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,argument="{"blockUpload":false,"blockShorts":{{{YouTube隐藏Shorts}}},"blockGames":{{{YouTube隐藏游戏}}},"blockVerticalLive":{{{YouTube隐藏竖屏直播}}},"autoCaptions":{{{YouTube自动字幕}}},"jumpAhead":false,"autoHd":false}",script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/gholts-surge/response.js
YouTube日志 = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/gholts-surge/request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com
