#!name=YouTube去广告
#!desc=首页、搜索、播放页、Shorts 里的广告，片头广告，适用于 YouTube 和 YouTube Music
#!category=AdBlock
#!system=ios

# 脚本来自 Maasea/sgmodule（Apache-2.0），存了一份在本仓库 scripts/vendor/Maasea-sgmodule
# 片头广告规则来自 fmz200/wool_scripts（GPL-3.0）
# 没用 Maasea 的 youtube.request.js：它会把播放请求重定向到作者自己的 Cloudflare Worker

[Map Local]
# 片头广告
^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
YouTube = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,argument="{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}",script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/Maasea-sgmodule/youtube.response.js

[MITM]
hostname = %APPEND% rr*.googlevideo.com, youtubei.googleapis.com
