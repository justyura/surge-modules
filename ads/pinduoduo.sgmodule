#!name=拼多多去广告
#!desc=开屏、首页弹窗，快递页红包商品推广
#!category=AdBlock
#!system=ios

# 规则来自 fmz200/wool_scripts（GPL-3.0）

[URL Rewrite]
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash - reject

[Body Rewrite]
http-response ^https?:\/\/mobile\.yangkeduo\.com\/proxy\/api\/api\/express\/post\/waybill\/red_packet\/goods_list$ "list":\[.+\] "list":[]

[Map Local]
^https?:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/homepage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, mobile.yangkeduo.com
