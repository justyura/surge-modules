#!name=高德地图去广告
#!desc=开屏、启动广告、增值推广，广告和统计域名
#!category=AdBlock
#!system=ios

# 规则来自 fmz200/wool_scripts（GPL-3.0）

[Rule]
DOMAIN-SUFFIX,optimus-ads.amap.com,REJECT
DOMAIN,optimus-ads.amap.com.w.alikunlun.com,REJECT
DOMAIN-SUFFIX,adiu.amap.com,REJECT
DOMAIN,aboard.apilocate.amap.com,REJECT
DOMAIN,apiinit.amap.com,REJECT
DOMAIN,icloud-amap.com,REJECT
DOMAIN-SUFFIX,logs.amap.com,REJECT
DOMAIN-SUFFIX,dualstack-logs.amap.com,REJECT
DOMAIN-SUFFIX,page.amap.com,REJECT
DOMAIN-SUFFIX,u51.me,REJECT

[URL Rewrite]
^https?:\/\/m5\.amap\.com\/ws\/valueadded\/ - reject
^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt - reject

[Map Local]
^https?:\/\/m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% m5.amap.com, amap-aos-info-nogw.amap.com
