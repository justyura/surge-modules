#!name=App 去广告合集
#!desc=哔哩哔哩、YouTube、抖音、小红书、Twitter、微博、知乎、微信、淘宝、闲鱼、京东、拼多多、美团和美团外卖、饿了么、高德地图。开屏和 App 内的广告、推广一起去
#!category=AdBlock
#!arguments=动态最常访问:auto,创作中心:0,过滤置顶评论广告:1,日志等级:4
#!arguments-desc=动态最常访问\n- auto: 有人在直播时才显示\n- show: 一直显示\n- hide: 一直隐藏\n\n创作中心\n- 0: 隐藏\n- 1: 显示\n\n过滤置顶评论广告\n- 0: 关\n- 1: 开\n\n日志等级\n- 1: DEBUG\n- 2: INFO\n- 3: WARN\n- 4: ERROR\n- 5: OFF

# 由 tools/build.py 从 ads/ 生成，不要手改
# 脚本都在本仓库 scripts/vendor/，来源和许可证见 scripts/vendor/README.md

[Rule]
# ---- 哔哩哔哩 ----
DOMAIN,api.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,api.biliapi.net,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.net,REJECT,pre-matching,extended-matching

# ---- 抖音 ----
DOMAIN-KEYWORD,bds.snssdk.com,REJECT
