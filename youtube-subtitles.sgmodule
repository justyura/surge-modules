#!name=YouTube 双语字幕
#!desc=YouTube 字幕和 YouTube Music 歌词加上中文翻译，翻译用 DeepL。基于 DualSubs
#!category=Enhancement
#!arguments=DeepL密钥:"填你的DeepL密钥",翻译服务:DeepL,目标语言:ZH,字幕类型:Translate,原文位置:Forward,自动显示字幕:true,只显示译文:false
#!arguments-desc=DeepL密钥\nDeepL API Free 的 key，以 :fx 结尾\n\n翻译服务\n- DeepL：用上面的 key\n- Google：免费，不用 key\n\n目标语言\nZH 中文，也可以填 EN、JA、KO 等\n\n字幕类型\n- Translate：用上面的翻译服务翻译\n- Official：用 YouTube 自带的机器翻译，不用 key\n\n原文位置\n- Forward：原文在上\n- Reverse：原文在下\n\n自动显示字幕\ntrue / false\n\n只显示译文\ntrue：只显示翻译，不显示原文

# 脚本来自 DualSubs（Apache-2.0），存了一份在本仓库 scripts/vendor/DualSubs-*，来源见 scripts/vendor/README.md
# DeepL key 只会发给 api-free.deepl.com

[Rule]
URL-REGEX,^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$,REJECT-TINYGIF

[Script]
# YouTube：给播放器加上翻译字幕选项
DualSubs.YouTube.Player.request.json = type=http-request,pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$,requires-body=1,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/request.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTube.Player.response.json = type=http-response,pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$,requires-body=1,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/response.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTube.Player.request.proto = type=http-request,pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$,requires-body=1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/request.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTube.Player.response.proto = type=http-response,pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$,requires-body=1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/response.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTube.GetWatch.response.proto = type=http-response,pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$,requires-body=1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/response.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
# YouTube：字幕文件
DualSubs.YouTube.TimedText.request = type=http-request,pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/request.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTube.Composite.TimedText.response = type=http-response,pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External),requires-body=1,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-Universal/Composite.Subtitles.response.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTube.Translate.TimedText.response = type=http-response,pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate,requires-body=1,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-Universal/Translate.response.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
# YouTube Music：歌词
DualSubs.YouTubeMusic.Browse.request.json = type=http-request,pattern=^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$,requires-body=1,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/request.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTube.Browse.request.proto = type=http-request,pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$,requires-body=1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-YouTube/request.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTubeMusic.Translate.Lyrics.response.json = type=http-response,pattern=^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate,requires-body=1,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-Universal/Translate.response.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"
DualSubs.YouTubeMusic.Translate.Lyrics.response.proto = type=http-response,pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/vendor/DualSubs-Universal/Translate.response.bundle.js,argument=Type="{{{字幕类型}}}"&Types="Translate"&AutoCC="{{{自动显示字幕}}}"&Position="{{{原文位置}}}"&Vendor="{{{翻译服务}}}"&ShowOnly="{{{只显示译文}}}"&LogLevel="WARN"&Languages[0]="AUTO"&Languages[1]="{{{目标语言}}}"&DeepL.Version="Free"&DeepL.Auth="{{{DeepL密钥}}}"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
