#!name=AdGuard Home 面板
#!desc=在 Surge 首页显示自建 AdGuard Home 的防护状态、24 小时查询和拦截数、拦截最多的域名；可以设成点一下暂停 / 恢复防护
#!arguments=地址:"填AdGuard Home网页后台地址",用户名:"填登录用户名",密码:"填登录密码",点击:refresh,暂停分钟:10
#!arguments-desc=地址\nAdGuard Home 网页后台的地址，就是浏览器里打开后台用的那个，例如 https://adguard.example.com，不带 /control\n\n用户名、密码\n网页后台的登录账号。只存在本机的 Surge 配置里。密码里不能有英文双引号\n\n点击\n- refresh：点面板刷新\n- pause：点面板暂停防护，再点恢复\n\n暂停分钟\n点击设成 pause 时一次暂停几分钟，到时间 AdGuard Home 自己恢复。填 0 表示一直关着，直到再点一下

# 脚本：scripts/adguard-home.js（本仓库自己写的），用 AdGuard Home 自己的接口，不用 MITM

[Panel]
AdGuardHome = title="AdGuard Home",content="点击刷新获取数据",style=info,script-name=adguard-home-panel,update-interval=1800

[Script]
adguard-home-panel = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/adguard-home.js,argument="url={{{地址}}}&user={{{用户名}}}&action={{{点击}}}&minutes={{{暂停分钟}}}&password={{{密码}}}"
