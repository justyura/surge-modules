#!name=翻译合集
#!desc=YouTube 字幕和评论、Reddit、X、GitHub、Stack Overflow 的翻译都在这一个模块里，只用填一个 OpenAI key：大模型结合上下文翻，DeepL / Google 兜底。每个站点可以单独关
#!category=Enhancement
#!arguments=大模型密钥:"填你的OpenAI密钥，多个用竖线分隔",DeepL密钥:"可以不填，大模型来不及或用不了时兜底",大模型:gpt-6-luna,大模型接口:"https://api.openai.com/v1",大模型思考:auto,目标语言:ZH-HANS,备用翻译:google,最长等待:6,调试日志:false,YouTube字幕:YouTube双语字幕,YouTube评论:YouTube评论翻译,Reddit:Reddit,X:X,GitHub:GitHub翻译,StackOverflow:StackOverflow翻译,StackOverflow网页:StackOverflow网页翻译,字幕原文位置:top,字幕最长等待:8,生词服务:不用就留着,评论展开:true,Reddit翻译范围:all,X屏蔽中文:true,X中文判定:normal,X白名单:"不屏蔽的账号，多个用竖线分隔",X翻译:all,GitHub翻译范围:all,GitHub改markdown:false,StackOverflow翻译范围:all,StackOverflow最多回答:10
#!arguments-desc=大模型密钥\nOpenAI 的 API key（sk-…），多个用 | 分隔，按顺序使用，出错自动换下一个。所有站点都用它，先用大模型结合上下文翻译，DeepL、Google 兜底\n\nDeepL密钥\nDeepL API key，多个用 | 分隔。不填也行：大模型来不及或用不了时直接用 Google 兜底\n\n大模型\n模型名，默认 gpt-6-luna（便宜、快）。也可以填 gpt-6-sol、gpt-4.1-mini 等；用别家接口就填那家的模型名\n\n大模型接口\n默认 OpenAI 官方。DeepSeek、OpenRouter 之类兼容 OpenAI 的接口填它们的地址\n\n大模型思考\n翻译不需要模型先「思考」，开着又慢又费钱，慢了还会来不及、变成 DeepL / Google 的译文\n- auto：按模型自动关掉，gpt-6-luna、gpt-6-sol、gpt-5.x 用 none，不支持 none 的用 low\n- none、low、medium、high：照这个填\n- off：不带这个参数，别家接口报错时用\n首页「翻译测试」面板点一下，能看到思考有没有关掉\n\n目标语言\nZH-HANS 简体中文，ZH-HANT 繁体中文，也可以填 EN-US、JA、KO 等\n\n备用翻译\n- google：大模型和 DeepL 都不能用时改用 Google 翻译\n- off：不兜底，显示原文\n\n最长等待\nReddit、X、GitHub、Stack Overflow App 最多等几秒翻译。离截止 2 秒还没翻好的先用 DeepL / Google 顶上，到时间没翻完的显示原文，重新打开接着翻。觉得刷新慢就调小\n\n调试日志\ntrue：在 Surge 日志里打印每个站点的请求、翻了几段、key 的切换情况\n\nYouTube字幕\nYouTube 字幕变双语。填 # 关掉\n\nYouTube评论\nYouTube 评论区和回复加译文。填 # 关掉\n\nReddit\nReddit App：去推广，标题、正文、评论加译文。填 # 关掉\n\nX\nX App 和 x.com：去推广、屏蔽中文推文，外文推文加译文。填 # 关掉\n\nGitHub\nGitHub 官方 App：Issue、PR、讨论、Release、README 加译文。填 # 关掉\n\nStackOverflow\n第三方 Stack Overflow App（Octostack 等）加译文。填 # 关掉\n\nStackOverflow网页\nSafari 里的 Stack Overflow 和 Stack Exchange 站点加译文。填 # 关掉\n\n字幕原文位置\nYouTube 字幕\n- top：原文在上，译文在下\n- bottom：译文在上，原文在下\n- only：只显示译文\n\n字幕最长等待\nYouTube 字幕最多等几秒。到时间先显示翻好的部分，重新打开字幕接着翻。YouTube 报「加载字幕时出错」就调小\n\n生词服务\n自己部署的 vox 生词服务地址，比如 http://192.168.1.2:8090。填了之后英文字幕里的生词会在第一次出现的那句下面标中文释义，每句最多 2 个\n\n评论展开\ntrue：YouTube 长评论直接显示全文；false：保持原样\n\nReddit翻译范围\n- all：标题、正文、评论都翻\n- title：只翻标题，省额度\n- off：不翻译，只去广告\n\nX屏蔽中文\ntrue：删掉 X 上的中文推文；false：只去广告和翻译\n\nX中文判定\n- normal：推文正文是中文才删（转推看被转的那条）\n- strict：另外，引用了中文推文、作者名字或简介里有汉字的推文也删，推荐关注里名字带汉字的账号也删。纯汉字的日文名字会误伤\n\nX白名单\nX 上这些账号的推文不删，填 @ 后面的用户名，多个用 | 分隔，不分大小写\n\nX翻译\n- all：推文正文后面接上译文\n- off：不翻译，只去广告和屏蔽中文\n\nGitHub翻译范围\n- all：标题、正文、评论、README 都翻\n- title：只翻标题和仓库简介，省额度\n- off：不翻译\n\nGitHub改markdown\n默认 false：只改 App 用来显示的 HTML，不动 markdown 原文，在 App 里编辑评论不会带上译文。\ntrue：markdown 原文也插译文。只有装好后标题有译文、正文和评论没有时才打开，打开后别在 App 里编辑别人能看到的内容\n\nStackOverflow翻译范围\nApp 和网页都按这个\n- all：标题、问题、回答、评论都翻\n- post：不翻评论，省额度\n- title：只翻标题\n- off：不翻译\n\nStackOverflow最多回答\nStack Overflow App 一次最多翻几个回答，按 App 里的顺序数。热门问题有上百个回答，全翻很费额度。填 0 不限

# 脚本都在 scripts/ 里，本仓库自己写的。首页的「翻译测试」面板点一下，用填的 key、模型和思考档位翻一小段字幕，看能不能用、快不快
# 大模型那段代码几个脚本共用，改 scripts/lib/llm.js 再跑 python3 tools/sync_llm.py
# 站点开关填 # 时，这个站点的脚本那一行变成注释；MITM 的域名还在
#
# YouTube 评论挂在请求阶段：/next（评论区）和 /browse（回复）的响应已经被「App 去广告合集」的脚本占了，
# Surge 一个响应只跑一个脚本，所以认出评论请求后由脚本自己去拿评论、翻译好直接返回，其他请求原样放行
# Reddit、X 的去广告和翻译在同一个脚本里，也是因为一个响应只跑一个脚本
# Stack Overflow 网页：第一个脚本往网页里插一段脚本，网页把段落发给同站的 /__surge-translate，第二个脚本拦下来翻好返回，key 不进网页

[Rule]
# 不让 X 走 QUIC，保证请求能被 MITM
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,x.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,twitter.com)),REJECT

[Panel]
TranslateTest = title="翻译测试",content="点一下，测试大模型 key、速度和思考有没有关掉",style=info,script-name=translate-test

[Script]
translate-test = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/translate-panel.js,argument="llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&target={{{目标语言}}}"
{{{YouTube字幕}}} = type=http-response,pattern=^https?:\/\/(?:(?:www|m)\.youtube\.com|youtubei\.googleapis\.com)\/api\/timedtext\?,requires-body=1,max-size=3145728,timeout=60,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/youtube-subtitles.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&position={{{字幕原文位置}}}&fallback={{{备用翻译}}}&budget={{{字幕最长等待}}}&vocab={{{生词服务}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&debug={{{调试日志}}}"
{{{YouTube评论}}} = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:next|browse)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/youtube-subtitles.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&position={{{字幕原文位置}}}&fallback={{{备用翻译}}}&budget={{{字幕最长等待}}}&vocab={{{生词服务}}}&expand={{{评论展开}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&debug={{{调试日志}}}"
{{{Reddit}}} = type=http-response,pattern=^https:\/\/(?:gql(?:-fed)?|oauth)\.reddit\.com\/,requires-body=1,max-size=5242880,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/reddit.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate={{{Reddit翻译范围}}}&fallback={{{备用翻译}}}&budget={{{最长等待}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&debug={{{调试日志}}}"
{{{X}}} = type=http-response,pattern=^https:\/\/(?:(?:x|twitter)\.com\/i\/api|api\.(?:x|twitter)\.com)\/graphql\/[\w-]+\/(?:\w*Timeline\w*|TweetDetail|ExplorePage|UserTweets\w*|UserMedia|UserHighlightsTweets|Likes|Bookmarks)(?:\?|$),requires-body=1,max-size=5242880,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/x.js,argument="chinese={{{X屏蔽中文}}}&mode={{{X中文判定}}}&allow={{{X白名单}}}&keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate={{{X翻译}}}&fallback={{{备用翻译}}}&budget={{{最长等待}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&debug={{{调试日志}}}"
{{{GitHub}}} = type=http-response,pattern=^https:\/\/api\.github\.com\/(?:graphql|repos\/|search\/issues),requires-body=1,max-size=3145728,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/github.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate={{{GitHub翻译范围}}}&markdown={{{GitHub改markdown}}}&fallback={{{备用翻译}}}&budget={{{最长等待}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&debug={{{调试日志}}}"
{{{StackOverflow}}} = type=http-response,pattern=^https:\/\/api\.stackexchange\.com\/2\.\d+\/(?!(?:sites|filters|info|access-tokens|apps|errors|privileges)(?:[\/?]|$)|(?:tags|badges)(?:\?|$)),requires-body=1,max-size=5242880,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/stackoverflow.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate={{{StackOverflow翻译范围}}}&answers={{{StackOverflow最多回答}}}&fallback={{{备用翻译}}}&budget={{{最长等待}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&debug={{{调试日志}}}"
{{{StackOverflow网页}}} = type=http-response,pattern=^https:\/\/(?:(?:[a-z]{2}\.|meta\.)?stackoverflow\.com|(?:meta\.)?(?:superuser\.com|serverfault\.com|askubuntu\.com|mathoverflow\.net)|(?!api\.|chat\.)[a-z0-9-]+(?:\.meta)?\.stackexchange\.com)\/(?:questions(?:[\/?]|$)|search\?|unanswered|\?|$),requires-body=1,max-size=4194304,timeout=10,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/stackoverflow-web.js,argument="translate={{{StackOverflow翻译范围}}}&debug={{{调试日志}}}"
{{{StackOverflow网页}}}接口 = type=http-request,pattern=^https:\/\/(?:(?:[a-z]{2}\.|meta\.)?stackoverflow\.com|(?:meta\.)?(?:superuser\.com|serverfault\.com|askubuntu\.com|mathoverflow\.net)|(?!api\.|chat\.)[a-z0-9-]+(?:\.meta)?\.stackexchange\.com)\/__surge-translate(?:\?.*)?$,requires-body=1,max-size=262144,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/stackoverflow-web.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate={{{StackOverflow翻译范围}}}&fallback={{{备用翻译}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&effort={{{大模型思考}}}&debug={{{调试日志}}}"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, youtubei.googleapis.com, gql.reddit.com, gql-fed.reddit.com, oauth.reddit.com, api.x.com, api.twitter.com, x.com, twitter.com, api.github.com, api.stackexchange.com, stackoverflow.com, *.stackoverflow.com, superuser.com, *.superuser.com, serverfault.com, *.serverfault.com, askubuntu.com, *.askubuntu.com, mathoverflow.net, *.mathoverflow.net, *.stackexchange.com
