#!name=翻译合集
#!desc=YouTube 字幕和评论、Reddit、X、GitHub、Stack Overflow 一起翻译，只用填一个 OpenAI key：大模型结合上下文翻，DeepL / Google 兜底。每个站点可以单独关
#!category=Enhancement
#!arguments=大模型密钥:"填你的OpenAI密钥，多个用竖线分隔",DeepL密钥:"可以不填，大模型来不及或用不了时兜底",大模型:gpt-4.1-mini,大模型接口:"https://api.openai.com/v1",目标语言:ZH-HANS,备用翻译:google,调试日志:false,YouTube字幕:YouTube双语字幕,YouTube评论:YouTube评论翻译,Reddit:Reddit,X:X,GitHub:GitHub翻译,StackOverflow:StackOverflow翻译,StackOverflow网页:StackOverflow网页翻译,字幕原文位置:top,字幕最长等待:8,生词服务:不用就留着,评论展开:true,X屏蔽中文:true,X白名单:"不屏蔽的账号，多个用竖线分隔"
#!arguments-desc=大模型密钥\nOpenAI 的 API key（sk-…），多个用 | 分隔，按顺序使用，出错自动换下一个。下面所有站点都用它，先用大模型结合上下文翻译，DeepL、Google 兜底\n\nDeepL密钥\nDeepL API key，多个用 | 分隔。不填也行：大模型来不及或用不了时直接用 Google 兜底\n\n大模型\n模型名，默认 gpt-4.1-mini（便宜、快、不思考）。想再省可以填 gpt-4.1-nano；用别家接口就填那家的模型名\n\n大模型接口\n默认 OpenAI 官方。DeepSeek、OpenRouter 之类兼容 OpenAI 的接口填它们的地址\n\n目标语言\nZH-HANS 简体中文，ZH-HANT 繁体中文，也可以填 EN-US、JA、KO 等\n\n备用翻译\n- google：大模型和 DeepL 都不能用时改用 Google 翻译\n- off：不兜底，显示原文\n\n调试日志\ntrue：在 Surge 日志里打印每个站点的请求、翻了几段、key 的切换情况\n\nYouTube字幕\nYouTube 字幕变双语。填 # 关掉\n\nYouTube评论\nYouTube 评论区和回复加译文。填 # 关掉\n\nReddit\nReddit App：去推广，标题、正文、评论加译文。填 # 关掉\n\nX\nX App 和 x.com：去推广、屏蔽中文推文，外文推文加译文。填 # 关掉\n\nGitHub\nGitHub 官方 App：Issue、PR、讨论、README 加译文。填 # 关掉\n\nStackOverflow\n第三方 Stack Overflow App（Octostack 等）加译文。填 # 关掉\n\nStackOverflow网页\nSafari 里的 Stack Overflow 和 Stack Exchange 站点加译文。填 # 关掉\n\n字幕原文位置\n- top：原文在上，译文在下\n- bottom：译文在上，原文在下\n- only：只显示译文\n\n字幕最长等待\nYouTube 字幕最多等几秒。离截止 2.5 秒还没翻好的先用 DeepL / Google 顶上，重新打开字幕接着用大模型翻。YouTube 报「加载字幕时出错」就调小\n\n生词服务\n自己部署的 vox 生词服务地址，比如 http://192.168.1.2:8090。填了之后英文字幕里的生词会标中文释义\n\n评论展开\ntrue：YouTube 长评论直接显示全文；false：保持原样\n\nX屏蔽中文\ntrue：删掉 X 上的中文推文；false：只去广告和翻译\n\nX白名单\nX 上这些账号的推文不删，填 @ 后面的用户名，多个用 | 分隔

# 由 tools/build_translate.py 从 youtube-subtitles.sgmodule、reddit.sgmodule、x.sgmodule、github.sgmodule、stackoverflow.sgmodule、stackoverflow-web.sgmodule 生成，不要手改。
# 装了这个就别再装上面那几个单独的翻译模块，同一个请求会被处理两次。
# 某个站点填 # 只是不跑脚本，MITM 的域名还在；完全不想解密某个站点就别用合集，装单独的模块

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,x.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,twitter.com)),REJECT

[Script]
{{{YouTube字幕}}} = type=http-response,pattern=^https?:\/\/(?:(?:www|m)\.youtube\.com|youtubei\.googleapis\.com)\/api\/timedtext\?,requires-body=1,max-size=3145728,timeout=60,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/youtube-subtitles.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&position={{{字幕原文位置}}}&fallback={{{备用翻译}}}&budget={{{字幕最长等待}}}&vocab={{{生词服务}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&debug={{{调试日志}}}"
{{{YouTube评论}}} = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:next|browse)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/youtube-subtitles.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&position={{{字幕原文位置}}}&fallback={{{备用翻译}}}&budget={{{字幕最长等待}}}&vocab={{{生词服务}}}&expand={{{评论展开}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&debug={{{调试日志}}}"
{{{Reddit}}} = type=http-response,pattern=^https:\/\/(?:gql(?:-fed)?|oauth)\.reddit\.com\/,requires-body=1,max-size=5242880,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/reddit.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate=all&fallback={{{备用翻译}}}&budget=6&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&debug={{{调试日志}}}"
{{{X}}} = type=http-response,pattern=^https:\/\/(?:(?:x|twitter)\.com\/i\/api|api\.(?:x|twitter)\.com)\/graphql\/[\w-]+\/(?:\w*Timeline\w*|TweetDetail|ExplorePage|UserTweets\w*|UserMedia|UserHighlightsTweets|Likes|Bookmarks)(?:\?|$),requires-body=1,max-size=5242880,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/x.js,argument="chinese={{{X屏蔽中文}}}&mode=normal&allow={{{X白名单}}}&keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate=all&fallback={{{备用翻译}}}&budget=6&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&debug={{{调试日志}}}"
{{{GitHub}}} = type=http-response,pattern=^https:\/\/api\.github\.com\/(?:graphql|repos\/|search\/issues),requires-body=1,max-size=3145728,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/github.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate=all&markdown=false&fallback={{{备用翻译}}}&budget=8&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&debug={{{调试日志}}}"
{{{StackOverflow}}} = type=http-response,pattern=^https:\/\/api\.stackexchange\.com\/2\.\d+\/(?!(?:sites|filters|info|access-tokens|apps|errors|privileges)(?:[\/?]|$)|(?:tags|badges)(?:\?|$)),requires-body=1,max-size=5242880,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/stackoverflow.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate=all&answers=10&fallback={{{备用翻译}}}&budget=8&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&debug={{{调试日志}}}"
{{{StackOverflow网页}}} = type=http-response,pattern=^https:\/\/(?:(?:[a-z]{2}\.|meta\.)?stackoverflow\.com|(?:meta\.)?(?:superuser\.com|serverfault\.com|askubuntu\.com|mathoverflow\.net)|(?!api\.|chat\.)[a-z0-9-]+(?:\.meta)?\.stackexchange\.com)\/(?:questions(?:[\/?]|$)|search\?|unanswered|\?|$),requires-body=1,max-size=4194304,timeout=10,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/stackoverflow-web.js,argument="translate=all&debug={{{调试日志}}}"
{{{StackOverflow网页}}}接口 = type=http-request,pattern=^https:\/\/(?:(?:[a-z]{2}\.|meta\.)?stackoverflow\.com|(?:meta\.)?(?:superuser\.com|serverfault\.com|askubuntu\.com|mathoverflow\.net)|(?!api\.|chat\.)[a-z0-9-]+(?:\.meta)?\.stackexchange\.com)\/__surge-translate(?:\?.*)?$,requires-body=1,max-size=262144,timeout=30,script-path=https://raw.githubusercontent.com/justyura/surge-modules/main/scripts/stackoverflow-web.js,argument="keys={{{DeepL密钥}}}&target={{{目标语言}}}&translate=all&fallback={{{备用翻译}}}&llmkeys={{{大模型密钥}}}&model={{{大模型}}}&api={{{大模型接口}}}&debug={{{调试日志}}}"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, youtubei.googleapis.com, gql.reddit.com, gql-fed.reddit.com, oauth.reddit.com, api.x.com, api.twitter.com, x.com, twitter.com, api.github.com, api.stackexchange.com, stackoverflow.com, *.stackoverflow.com, superuser.com, *.superuser.com, serverfault.com, *.serverfault.com, askubuntu.com, *.askubuntu.com, mathoverflow.net, *.mathoverflow.net, *.stackexchange.com
